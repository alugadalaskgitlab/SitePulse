VAPID_PUBLIC_KEY = "BLd9s-RA4C4aHcxhghJGdnmLnCaq6S2fE8EjX9rkn2RfIIGZjHFGoA5Ne0Hk7tMDv5shoPemCSjaqYlLCSCfN0o"
